# Django settings
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-backend-name.onrender.com
DATABASE_URL=postgres://username:password@hostname:port/dbname

# Frontend
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@example.com

# Security settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# F1 AI Analyst (server-side only)
OPENAI_API_KEY=
AI_MODEL=gpt-5-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_TOOL_CALLS=6
AI_PROVIDER_TIMEOUT=20
AI_REQUEST_TIMEOUT=90
AI_THROTTLE_RATE=10/hour
AUTH_LOGIN_RATE=10/minute
AUTH_REGISTRATION_RATE=10/hour
AUTH_PASSWORD_RESET_RATE=10/hour
AUTH_REFRESH_RATE=60/minute
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.3
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
# Shared throttle cache for production workers:
# AI_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
# AI_CACHE_LOCATION=f1_ai_cache
# Then run: python manage.py createcachetable f1_ai_cache

# Optional offline demo: explicitly use --settings=config.settings.demo.
# Demo mode is disabled in normal settings and forbidden in production.
# python manage.py setup_ai_demo --settings=config.settings.demo
# Optional NEW isolated SQLite demo path (never point this at existing data):
# AI_DEMO_DB=/absolute/path/to/ai-demo.sqlite3
